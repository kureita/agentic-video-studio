{
  "name": "kureita-video-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "cd apps/api && uv run uvicorn main:app --reload --port 8000",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean"
  },
  "overrides": {
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  }
}