# ============================================
# Kureita AI Video Platform - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# Application
APP_NAME=Kureita API
# local → Dodo test_mode + loads .env.local | prod → Dodo live_mode + loads .env.prod
APP_ENV=local
DEBUG=true
# Return URL host after Dodo checkout (prod: https://app.kureita.com)
WEB_APP_URL=http://localhost:3000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================
# Database - MongoDB
# ============================================
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=kureita

# ============================================
# AI/LLM APIs (Required)
# ============================================

# OpenAI - For GPT models (story generation, script writing)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Gemini - For Veo 3.1 video generation (includes native audio!)
# Get your API key free at: https://aistudio.google.com/apikey
# Veo is in preview; if you get 400 INVALID_ARGUMENT / "use case not supported", set USE_MOCK_VEO=true
GEMINI_API_KEY=your-gemini-api-key-here
USE_MOCK_VEO=true

# Kling AI - For video generation (lip sync, motion control etc)
KLING_API_KEY=your-kling-api-key-here
# Debug-only safety switch: logs payload and skips fal submission for video nodes
FAL_VIDEO_DEBUG_DRY_RUN=false

# BytePlus - For Seeddance 2.0 and image models
BYTEPLUS_API_KEY=your-byteplus-api-key-here

# ============================================
# AWS Services (Optional)
# ============================================
# Used for S3 storage, SES email, and other AWS services

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# S3 Storage
S3_BUCKET=kureita-assets
S3_ENDPOINT=  # Optional: for S3-compatible services (Cloudflare R2, MinIO)

# Upload limits
UPLOAD_MAX_IMAGE_MB=25
UPLOAD_MAX_VIDEO_MB=100
UPLOAD_MAX_AUDIO_MB=50
UPLOAD_API_MAX_MB=8
TENANT_ASSET_STORAGE_QUOTA_MB=500

# ============================================
# Optional Services
# ============================================

# ElevenLabs - Text-to-speech for audio generation
# Get your API key at: https://elevenlabs.io/
ELEVENLABS_API_KEY=

# Audio Generation Settings
# Set to true to use free gTTS instead of ElevenLabs (for testing)
USE_MOCK_AUDIO=false

# Redis (for background jobs)
REDIS_URL=redis://localhost:6379

# Firecrawl (advanced web scraping)
FIRECRAWL_API_KEY=

# ============================================
# Auth0
# ============================================
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.kureita.com

# ============================================
# Dodo Payments (card top-ups)
# ============================================
# Developer → API (test key in sandbox, live key in production)
DODO_PAYMENTS_API_KEY=
# Developer → Webhooks: add endpoint URL below, then copy the signing secret (whsec_...)
# URL to register: https://<your-api-host>/api/billing/dodo/webhook
DODO_WEBHOOK_SECRET=
# One one-time product with "Pay what you want" enabled — same product in test & live dashboards
DODO_TOPUP_PRODUCT_ID=
# Optional bounds (must align with limits you set on that product in Dodo)
DODO_MIN_TOPUP_USD=10
DODO_MAX_TOPUP_USD=500
# Public API URL (documented for webhook setup)
API_BASE_URL=http://localhost:8000
