# ============================================
# Kureita AI Video Platform - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# Application
APP_NAME=Kureita API
DEBUG=true

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================
# Database - MongoDB
# ============================================
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=kureita

# ============================================
# AI/LLM APIs (Required)
# ============================================

# OpenAI - For GPT models (story generation, script writing)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Gemini - For Veo 3.1 video generation (includes native audio!)
# Get your API key free at: https://aistudio.google.com/apikey
# Veo is in preview; if you get 400 INVALID_ARGUMENT / "use case not supported", set USE_MOCK_VEO=true
GEMINI_API_KEY=your-gemini-api-key-here
USE_MOCK_VEO=true

# ============================================
# AWS Services (Optional)
# ============================================
# Used for S3 storage, SES email, and other AWS services

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# S3 Storage
S3_BUCKET=kureita-assets
S3_ENDPOINT=  # Optional: for S3-compatible services (Cloudflare R2, MinIO)

# ============================================
# Optional Services
# ============================================

# ElevenLabs - Custom voiceovers (OPTIONAL - Veo 3.1 has native audio)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Redis (for background jobs)
REDIS_URL=redis://localhost:6379

# Firecrawl (advanced web scraping)
FIRECRAWL_API_KEY=
